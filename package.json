{
  "name": "lunar-orbit-explorer",
  "version": "0.1.0",
  "description": "Guided explainer of why lumpy lunar gravity destroys low orbits: Rust/WASM propagator + CesiumJS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:wasm": "cd propagator && wasm-pack build --target web",
    "dev:full": "npm run build:wasm && npm run dev",
    "test": "node --test web/tests/*.test.mjs",
    "build:all": "npm run build:wasm && vite build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "cesium": "^1.115.0"
  },
  "devDependencies": {
    "vite": "^8.0.8",
    "vite-plugin-cesium": "^1.2.23"
  }
}
